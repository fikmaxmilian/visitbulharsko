---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import { absoluteUrl, canonicalUrl, withBase } from '../../utils/paths';
import data from '../../data/site-data.json';

export function getStaticPaths() {
  return [...data.posts, ...data.pages]
    .filter((p) => p.path !== '/')
    .map((p) => ({ params: { slug: p.slug }, props: { item: p } }));
}
const { item } = Astro.props;
const newsCategorySlugs = new Set(['zpravy-bulharsko']);
const isQuickNewsPost = (post: any) => {
  const hasNewsCategory = post.categories?.some((category: any) => newsCategorySlugs.has(category.slug));
  const usesDefaultNewsImage = /header-image-2-1\.webp$/.test(post.featured_image || '');
  const isShortGeneratedUpdate = Number(post.reading_minutes || 0) <= 2 && usesDefaultNewsImage;
  return hasNewsCategory || isShortGeneratedUpdate;
};
const itemCategorySlugs = new Set((item.categories || []).map((category: any) => category.slug).filter((slug: string) => !newsCategorySlugs.has(slug)));
const sameCategoryRelated = data.posts.filter((post: any) =>
  post.slug !== item.slug &&
  !isQuickNewsPost(post) &&
  post.categories?.some((category: any) => itemCategorySlugs.has(category.slug))
);
const fallbackRelated = data.posts.filter((post: any) =>
  post.slug !== item.slug &&
  !isQuickNewsPost(post) &&
  !sameCategoryRelated.some((relatedPost: any) => relatedPost.slug === post.slug)
);
const related = [...sameCategoryRelated, ...fallbackRelated].slice(0, 3);
const isCurrentQuickNews = isQuickNewsPost(item);
const visibleFeaturedImage = isCurrentQuickNews ? '' : item.featured_image;
const title = item.seo?.title || item.title;
const description = item.seo?.description || item.excerpt || 'Visit Bulharsko';
const date = item.date ? new Date(item.date).toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
const strippedContent = (item.content || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Visit Bulharsko', item: canonicalUrl('/') },
    ...(item.categories?.[0] ? [{ '@type': 'ListItem', position: 2, name: item.categories[0].name, item: canonicalUrl(`/category/${item.categories[0].slug}/`) }] : []),
    { '@type': 'ListItem', position: item.categories?.[0] ? 3 : 2, name: item.title, item: canonicalUrl(item.path) },
  ],
};
const articleSchema = item.type === 'post' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: item.title,
  description,
  image: visibleFeaturedImage ? [absoluteUrl(visibleFeaturedImage)] : undefined,
  datePublished: item.date,
  dateModified: item.modified || item.date,
  author: { '@type': 'Person', name: 'Luke Palm' },
  publisher: {
    '@type': 'Organization',
    name: 'Visit Bulharsko',
    logo: { '@type': 'ImageObject', url: absoluteUrl('/uploads/2023/07/cropped-Visit-Bulharsko-1.webp') },
  },
  mainEntityOfPage: canonicalUrl(item.path),
  articleSection: item.categories?.[0]?.name,
  wordCount: strippedContent.split(/\s+/).filter(Boolean).length,
} : null;
const pageSchema = item.type !== 'post' ? {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: item.title,
  description,
  url: canonicalUrl(item.path),
  inLanguage: 'cs-CZ',
  isPartOf: { '@type': 'WebSite', name: 'Visit Bulharsko', url: canonicalUrl('/') },
} : null;

function splitArticleContent(html = '') {
  if (item.type !== 'post') return [html, '', ''];
  const matches = [...html.matchAll(/<\/p>/gi)];
  if (matches.length < 5) return [html, '', ''];
  const firstIndex = Math.min(3, matches.length - 1);
  const secondIndex = Math.min(9, matches.length - 1);
  const firstBreak = matches[firstIndex].index + matches[firstIndex][0].length;
  const secondBreak = secondIndex > firstIndex ? matches[secondIndex].index + matches[secondIndex][0].length : 0;
  return [
    html.slice(0, firstBreak),
    secondBreak ? html.slice(firstBreak, secondBreak) : html.slice(firstBreak),
    secondBreak ? html.slice(secondBreak) : '',
  ];
}

const articleContentParts = splitArticleContent(item.content || '');
---
<BaseLayout title={title} description={description} image={visibleFeaturedImage || undefined} canonical={item.path} type={item.type === 'post' ? 'article' : 'website'} schema={[articleSchema, pageSchema, breadcrumbs]}>
  <article class="mx-auto max-w-4xl px-5 pt-12">
    <div class="text-center">
      {item.categories?.[0] && <a href={`/category/${item.categories[0].slug}/`} class="meta-chip">{item.categories[0].name}</a>}
      <h1 class="mt-5 font-display text-4xl font-black leading-tight md:text-6xl">{item.title}</h1>
      {item.type === 'post' && <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-plum/60">Luke Palm · {date} · {item.reading_minutes} min čtení</p>}
      {item.excerpt && <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-plum/75">{item.excerpt}</p>}
    </div>
    {visibleFeaturedImage && <img src={withBase(visibleFeaturedImage)} alt={item.featured_alt || item.title} class="mt-10 max-h-[560px] w-full rounded-[2rem] object-cover shadow-soft" />}
    {item.type === 'post' && !isCurrentQuickNews && <div class="my-10"><PromoBanner /></div>}
    <div class="my-10"><AdSlot type="article" label="ADS / in-article reklama" /></div>
    <div class="article-content" set:html={articleContentParts[0]}></div>
    {item.type === 'post' && articleContentParts[1] && <div class="my-10"><AdSlot type="article" label="ADS / in-article reklama uvnitř článku" /></div>}
    {articleContentParts[1] && <div class="article-content" set:html={articleContentParts[1]}></div>}
    {item.type === 'post' && articleContentParts[2] && !isCurrentQuickNews && <div class="my-10"><PromoBanner /></div>}
    {articleContentParts[2] && <div class="article-content" set:html={articleContentParts[2]}></div>}
  </article>
  {item.type === 'post' && (
    <section class="section-wrap"><div class="section-head"><h2>Související články</h2><a href={withBase('/')}>Zpět na magazín →</a></div><div class="grid gap-8 md:grid-cols-3">{related.map((p) => <PostCard post={p} hideImage={isCurrentQuickNews} />)}</div><div class="mt-10"><AdSlot type="multiplex" label="ADS / doporučené odkazy" /></div></section>
  )}
</BaseLayout>
