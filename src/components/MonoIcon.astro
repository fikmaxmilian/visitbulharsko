---
type IconName = 'compass' | 'beach' | 'pin' | 'news' | 'plane';
const { name } = Astro.props as { name: IconName };
---
<span class="mono-icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
    {name === 'compass' && <><circle cx="12" cy="12" r="8"/><path d="m15 9-2.3 5.7L9 16l2.3-5.7L15 9Z"/></>}
    {name === 'beach' && <><path d="M3 18h18"/><path d="M7 18c1.2-3.6 4-6 8-7"/><path d="M5 11c4-4 9-5 14-1"/><path d="M12 6v12"/></>}
    {name === 'pin' && <><path d="M12 21s6-5.2 6-11a6 6 0 0 0-12 0c0 5.8 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/></>}
    {name === 'news' && <><path d="M5 5h14v14H5z"/><path d="M8 9h8"/><path d="M8 13h8"/><path d="M8 17h5"/></>}
    {name === 'plane' && <><path d="M3 11l18-7-7 18-3-8-8-3Z"/><path d="m11 14 10-10"/></>}
  </svg>
</span>
