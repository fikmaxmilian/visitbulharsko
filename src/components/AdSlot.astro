---
const {
  label,
  type = 'horizontal',
  class: className = '',
} = Astro.props;

const client = 'ca-pub-5857769079063765';

const adTypes = {
  horizontal: {
    slot: '4825066786',
    label: 'ADS / vodorovná reklama',
    className: 'ad-wide',
    style: 'display:block',
    attrs: {
      'data-ad-format': 'auto',
      'data-full-width-responsive': 'true',
    },
  },
  vertical: {
    slot: '8572740100',
    label: 'ADS / svislá reklama',
    className: 'ad-box',
    style: 'display:block',
    attrs: {
      'data-ad-format': 'auto',
      'data-full-width-responsive': 'true',
    },
  },
  square: {
    slot: '8572740100',
    label: 'ADS / čtvercová reklama',
    className: 'ad-square',
    style: 'display:block',
    attrs: {
      'data-ad-format': 'auto',
      'data-full-width-responsive': 'true',
    },
  },
  feed: {
    slot: '5051317555',
    label: 'ADS / in-feed reklama',
    className: 'ad-feed',
    style: 'display:block',
    attrs: {
      'data-ad-format': 'fluid',
      'data-ad-layout-key': '-5n+co-k-8t+pg',
    },
  },
  article: {
    slot: '7938315281',
    label: 'ADS / in-article reklama',
    className: 'ad-article',
    style: 'display:block; text-align:center;',
    attrs: {
      'data-ad-layout': 'in-article',
      'data-ad-format': 'fluid',
    },
  },
  multiplex: {
    slot: '8798990874',
    label: 'ADS / doporučené odkazy',
    className: 'ad-multiplex',
    style: 'display:block',
    attrs: {
      'data-ad-format': 'autorelaxed',
    },
  },
};

type AdType = keyof typeof adTypes;

const aliases: Record<string, AdType> = {
  banner: 'horizontal',
  wide: 'horizontal',
  box: 'square',
  sidebar: 'vertical',
  inFeed: 'feed',
  inArticle: 'article',
};

const requestedType = String(type);
const resolvedType: AdType = aliases[requestedType] || (requestedType in adTypes ? requestedType as AdType : 'horizontal');
const config = adTypes[resolvedType];
const adLabel = label || config.label;
const adClass = ['ad-slot', config.className, className].filter(Boolean).join(' ');
---
<div class={adClass} aria-label={adLabel} data-ad-unit={resolvedType}>
  <span class="ad-slot__placeholder" aria-hidden="true">{adLabel}</span>
  <ins
    class="adsbygoogle"
    style={config.style}
    data-ad-client={client}
    data-ad-slot={config.slot}
    {...config.attrs}
  ></ins>
  <script is:inline>
    (window.adsbygoogle = window.adsbygoogle || []).push({});
  </script>
  <noscript><span>{adLabel}</span></noscript>
</div>
